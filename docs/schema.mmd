    audit_archives {
      uuid id PK
      varchar period
      varchar path
      varchar checksum
      bigint row_count
      timestamp first_entry_at
      timestamp last_entry_at
      timestamp finalized_at
      timestamp created_at
      timestamp updated_at
    }
    audit_chain_checkpoints {
      uuid id PK
      varchar anchor_hash
      timestamp pruned_through
      varchar bundle_manifest_path
      timestamp created_at
