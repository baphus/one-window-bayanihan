    survey_invitations {
      uuid id PK
      uuid survey_form_id FK
      uuid case_id FK
      uuid agency_id FK
      uuid referral_id FK
      varchar client_name
      varchar client_email
      varchar service_name
      varchar token
      varchar token_hash
      timestamp expires_at
      timestamp submitted_at
      timestamp created_at
      timestamp updated_at
    }
    survey_responses {
      uuid id PK
      uuid survey_invitation_id FK
      uuid survey_question_id FK
      text answer
      jsonb selected_options
      timestamp created_at
    }
    generated_documents {
      uuid id PK
      uuid user_id FK
      uuid case_id FK
      varchar type
      varchar filename
      varchar path
      bigint file_size
      varchar mime_type
      varchar status
      text error_message
      timestamp created_at
      timestamp updated_at
    }
    email_logs {
      timestamp resent_at
      uuid id PK
      varchar to_email
      varchar subject
      varchar mailable_type
      varchar status
      uuid job_uuid
      text error_message
      timestamp sent_at
      varchar provider_message_id
      timestamp delivered_at
      timestamp created_at
      timestamp updated_at
    }
    email_events {
      uuid id PK
      uuid email_log_id FK
      varchar provider_message_id
      varchar event_type
      timestamp occurred_at
      varchar svix_id
      jsonb payload
      timestamp created_at
      timestamp updated_at
    }
    notifications {
      uuid id PK
      varchar type
      uuid notifiable_id
      varchar notifiable_type
      text data
      timestamp read_at
      timestamp created_at
      timestamp updated_at
    }
    user_invites {
      uuid id PK
      varchar email
      varchar role
      uuid agcy_id FK
      varchar token
      varchar token_hash
      timestamp expires_at
      uuid created_by FK
      timestamp consumed_at
      timestamp cancelled_at
      timestamp created_at
      timestamp updated_at
    }
    system_settings {
      varchar key PK
      varchar category
      text value
      text description
      timestamp created_at
      timestamp updated_at
    }
    activity_events {
      uuid id PK
      timestamptz occurred_at
      uuid actor_id FK
      varchar actor_name
      varchar actor_role
      varchar module
      varchar action
      text description
      uuid entity_id
      uuid audit_log_id FK
      timestamp created_at
      timestamp updated_at
    }
    referral_client_attachment_agencies {
      uuid attachment_id FK
      uuid agency_id FK
      timestamp created_at
      timestamp updated_at
    }
    referral_client_request_item_services {
      uuid request_item_id FK
      uuid service_requirement_id FK
      timestamp created_at
      timestamp updated_at
    }
    helpdesk_article_feedback {
      uuid id PK
      varchar article_slug
      varchar identity_hash
      varchar vote
      timestamp created_at
      timestamp updated_at
    }
