    agency_thread_reads {
      uuid user_id FK
      uuid case_id FK
      uuid peer_agency_id FK
      timestamp last_read_at
    }
    audit_logs {
      uuid id PK
      varchar action
      varchar module
      uuid entity_id
      text description
      jsonb old_value
      jsonb new_value
