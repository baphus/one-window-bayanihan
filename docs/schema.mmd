erDiagram
    %% Domain/application schema; SQL baseline plus post-squash migrations through 2026-11-01.
    %% Composite keys and CHECK/index details are documented in schema.dbml and SQL.
    users {
      uuid id PK
      varchar name
      varchar email
      varchar password
      varchar role
      uuid agcy_id FK
      boolean is_active
      varchar contact_number
      text avatar_url
      varchar position
      varchar department
      varchar office_location
      text bio
      text emergency_contact
      varchar timezone
      text mfa_secret
      json mfa_recovery_codes
      timestamp mfa_enabled_at
      json notifications_config
      timestamp onboarding_completed_at
      varchar onboarding_step
      timestamp profile_completed_at
      timestamp email_verified_at
      varchar remember_token
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
      json seen_page_guides
      json checklist_progress
      uuid client_id FK
      bigint mfa_last_totp_counter
    }
    clients {
      uuid id PK
      text first_name
      text last_name
      text middle_name
      text suffix
      text date_of_birth
      varchar sex
      text email
      text contact_number
      varchar avatar_url
      varchar type
      uuid user_id FK
      uuid ofw_client_id FK
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
    }
    agencies {
      uuid id PK
      varchar name
      varchar short
      varchar slug
      text description
      varchar contact_info
      text map_link
      text logo_url
      text location_query
      boolean is_active
      boolean is_default
      numeric latitude
      numeric longitude
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
    }
    cases {
      uuid id PK
      varchar case_number
      varchar tracker_number
      varchar vulnerability_indicator
      varchar nok_vulnerability_indicator
      text summary
      varchar status
      timestamp closed_at
      timestamp consent_given_at
      uuid user_id FK
      uuid client_id FK
      uuid category_id FK
      uuid case_issue_id FK
      varchar escalation_reason
      uuid reviewed_by FK
      timestamp reviewed_at
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      text deletion_reason
      timestamp created_at
      timestamp updated_at
    }
    case_categories {
      uuid id PK
      varchar name
      text description
      varchar color
      integer sort_order
      boolean is_active
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
    }
    case_issues {
      uuid id PK
      varchar name
      text description
      integer sort_order
      boolean is_active
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
    }
    case_statuses {
      uuid id PK
      varchar name
      varchar slug
      varchar type
      varchar color
      integer sort_order
      boolean is_system
      boolean is_active
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
    }
    case_category {
      uuid id PK
      uuid case_id FK
      uuid case_category_id FK
      timestamp created_at
      timestamp updated_at
    }
    case_documents {
      timestamp files_deleted_at
      uuid id PK
      varchar file_name
      text file_path
      varchar file_type
      bigint size
      uuid case_id FK
      uuid referral_id FK
      uuid user_id FK
      varchar category
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
    }
    case_events {
      uuid id PK
      bigint sequence
      uuid case_id FK
      uuid referral_id FK
      varchar type
      varchar title
      text description
      jsonb meta
      varchar actor_type
      timestamp occurred_at
      timestamp created_at
    }
    case_notifications {
      uuid id PK
      uuid case_id FK
      varchar client_email
      varchar type
      varchar title
      text message
      json data
      varchar related_url
      timestamp read_at
      timestamp created_at
      timestamp updated_at
    }
    case_number_counters {
      integer period PK
      integer last_number
      timestamp created_at
      timestamp updated_at
    }
    client_addresses {
      varchar barangay_code
      varchar city_municipality_code
      varchar province_code
      varchar region_code
      uuid id PK
      uuid client_id FK
      varchar region
      varchar province
      varchar city_municipality
      varchar barangay
      text street
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
    }
    client_employments {
      date date_of_arrival
      date end_date
      date start_date
      text last_country
      text country
      text last_position
      uuid id PK
      uuid client_id FK
      text employer_name
      text position
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
    }
    next_of_kin {
      varchar barangay_code
      varchar city_municipality_code
      varchar province_code
      varchar region_code
      uuid id PK
      uuid client_id FK
      text first_name
      text last_name
      text middle_name
      varchar relationship
      boolean is_primary
      text phone_number
      text email
      text full_address
      varchar region
      varchar province
      varchar city_municipality
      varchar barangay
      text street
      integer sort_order
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
    }
    referrals {
      uuid id PK
      uuid case_id FK
      uuid agcy_id FK
      text required_services
      text notes
      varchar status
      varchar decision
      text decision_comment
      varchar rejection_reason
      timestamp first_action_at
      timestamp referral_assigned_at
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
    }
    referral_services {
      uuid referral_id FK
      uuid service_id FK
      timestamp created_at
      timestamp updated_at
    }
    services {
      uuid id PK
      varchar name
      text description
      uuid agcy_id FK
      integer processing_days
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
    }
    service_requirements {
      uuid id PK
      varchar name
      text description
      boolean is_required
      uuid service_id FK
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
    }
    referral_service_requirements {
      uuid id PK
      uuid referral_id FK
      uuid service_id FK
      varchar name
      text description
      boolean is_required
      integer sort_order
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
    }
    referral_messages {
      uuid id PK
      uuid referral_id FK
      uuid sender_user_id FK
      text body
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
    }
    referral_comments {
      uuid id PK
      uuid refr_id FK
      uuid parent_id FK
      text content
      varchar visibility
      boolean is_edited
      uuid user_id FK
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
    }
    referral_attachments {
      timestamp files_deleted_at
      uuid id PK
      uuid referral_id FK
      varchar file_name
      text file_path
      varchar file_type
      bigint size
      uuid user_id FK
      uuid replaces_id FK
      uuid version_group_id
      boolean is_archived
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
    }
    referral_client_requests {
      uuid id PK
      uuid referral_id FK
      uuid creator_user_id FK
      varchar type
      varchar title
      text instructions
      varchar status
      timestamp due_at
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
    }
    referral_client_request_items {
      uuid source_requirement_id FK
      text description
      varchar canonical_key
      uuid id PK
      uuid request_id FK
      varchar label
      integer sort_order
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
    }
    referral_client_messages {
      uuid id PK
      uuid request_id FK
      text body
      varchar sender_kind
      uuid user_id FK
      uuid access_link_id FK
      varchar kind
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
    }
    referral_client_message_attachments {
      uuid request_item_id FK
      varchar review_status
      varchar visibility
      varchar sha256
      timestamp files_deleted_at
      uuid id PK
      uuid message_id FK
      varchar file_name
      varchar file_path
      varchar file_type
      bigint size
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
    }
    referral_client_access_links {
      uuid id PK
      uuid request_id FK
      varchar token_hash
      timestamp expires_at
      timestamp revoked_at
      uuid revoked_by FK
      uuid issued_by FK
      text recipient_snapshot
      timestamp first_used_at
      timestamp last_used_at
      integer use_count
      timestamp created_at
      timestamp updated_at
    }
    milestones {
      uuid id PK
      varchar title
      text description
      uuid refr_id FK
      uuid user_id FK
      json requirements
      uuid client_request_id FK
      boolean is_deleted
      timestamp deleted_at
      uuid deleted_by FK
      timestamp created_at
      timestamp updated_at
